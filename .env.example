PA_SERVER_API_KEY=your-prophet-arena-api-key
PA_SERVER_URL=https://api.aiprophet.dev
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the forecast model (default: anthropic/claude-sonnet-4-6)
# PROPHET_FORECAST_MODEL=openai/gpt-5.5
# Optional: override the triage model (default: openai/gpt-5.4-mini)
# PROPHET_TRIAGE_MODEL=openai/gpt-5.4-mini
# Optional: number of ticks for the experiment (default: 96)
# PA_N_TICKS=96
