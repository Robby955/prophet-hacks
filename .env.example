PA_SERVER_API_KEY=your-prophet-arena-api-key
PA_SERVER_URL=https://api.aiprophet.dev
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Required only for the production retrieval variant to use web evidence.
# Leave unset to fall back to the non-retrieval multi_outcome variant.
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Optional: FastAPI forecast endpoint variant.
# Production serves multi_outcome_retrieval.
PROPHET_AGENT_VARIANT=multi_outcome_retrieval

# Optional in local dev, required in production to keep live monitoring private.
# Protects /dashboard, /predictions, /events, /compare, /compare-open.
# /predict + /healthz + /login stay public for Prophet Arena / sign-in.
# DASHBOARD_AUTH_TOKEN=replace-with-a-long-random-token

# Shareable PIN. When set, /login renders a PIN entry form; on success it
# issues the DASHBOARD_AUTH_TOKEN cookie. Lets you share the dashboard URL
# without putting the long random token in the URL. Rate-limited
# (6/min, 12-attempt 5-min lockout). Numeric is fine.
# DASHBOARD_PIN=replace-with-a-numeric-pin

# Set by scripts/agent/deploy.sh in Railway so /healthz can show the live SHA.
# PROPHET_BUILD_COMMIT_SHA=local-dev

# Optional: OpenRouter unified-API key, used by scripts/ablate_openrouter.py
# for swap-the-LLM ablations against Gemini / GPT-5.2 / Opus 4.6, etc.
# NOT used by the live /predict path.
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Anthropic Haiku 4.5 model id used by the outcomes safety net
# (forecast_track.py:_infer_outcomes_when_missing). Falls back to a built-in
# default; override if you want a different fast model.
# PROPHET_INFERENCE_MODEL=claude-haiku-4-5-20251001

# Optional: override forecast-track models.
PROPHET_FORECAST_TRACK_MODEL=claude-sonnet-4-6
PROPHET_FORECAST_OPENAI_MODEL=gpt-5.5
PROPHET_FORECAST_OPUS_MODEL=claude-opus-4-7
PROPHET_FORECAST_OPUS46_MODEL=claude-opus-4-6
PROPHET_FORECAST_GPT52_MODEL=gpt-5.2

# Optional: override the trading-track forecast model (default: anthropic/claude-sonnet-4-6)
# PROPHET_FORECAST_MODEL=openai/gpt-5.5
# Optional: override the trading-track triage model (default: openai/gpt-5.4-mini)
# PROPHET_TRIAGE_MODEL=openai/gpt-5.4-mini
# Optional: number of ticks for the experiment (default: 96)
# PA_N_TICKS=96
